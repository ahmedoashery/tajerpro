generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
}

enum StockMovementType {
  SALE
  RESTOCK
  RETURN
  ADJUSTMENT
  PURCHASE
  PURCHASE_RETURN
  STOCKTAKE
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
  CREDIT
  SPLIT
}

enum TreasuryType {
  CASH_DRAWER
  INSTAPAY
  WALLET
  BANK_POS
}

enum PriceTier {
  RETAIL
  HALF_WHOLESALE
  WHOLESALE
  CUSTOM
}

enum InvoiceStatus {
  COMPLETED
  PARTIAL_RETURNED
  RETURNED
}

enum PaymentTxStatus {
  CONFIRMED
  PENDING
  FAILED
  REFUNDED
}

enum PromotionRuleType {
  PERCENT
  FIXED
  BOGO_QTY
}

enum QuotationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SHIPPING
  MAINTENANCE
  TAXES
  OWNER_DRAW
  MISC
}

enum ExpensePaymentSource {
  CASH_DRAWER
  BANK_INSTAPAY
  WALLET
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum PurchasePaymentSource {
  CASH
  BANK_TRANSFER
  CREDIT
}

enum EquityDrawingType {
  DRAW
  SETTLEMENT
  CAPITAL_ADD
}

enum ScheduledFrequency {
  DAILY
  WEEKLY
}

enum ScheduledChannel {
  IN_APP
  EMAIL
  BOTH
}

model StoreSettings {
  id                  Int      @id @default(1)
  storeName           String   @db.VarChar(180)
  activityId          String   @default("grocery") @db.VarChar(64)
  phone               String   @db.VarChar(32)
  address             String   @db.VarChar(255)
  taxNumber           String   @default("") @db.VarChar(64)
  vatPercent          Decimal  @default(0) @db.Decimal(5, 2)
  receiptFooter       String   @db.VarChar(320)
  currency            String   @default("EGP") @db.VarChar(8)
  allowNegativeStock  Boolean  @default(false)
  autoPrintAfterSale  Boolean  @default(true)
  requireLoginOnStart Boolean  @default(false)
  loyaltyEnabled      Boolean  @default(true)
  earnRateEgpPerPoint Decimal  @default(50) @db.Decimal(10, 2)
  pointValueEgp       Decimal  @default(1) @db.Decimal(10, 2)
  minRedeemPoints     Int      @default(10)
  instapayIpa         String   @default("tajirpro@instapay") @db.VarChar(120)
  vodafoneCashNumber  String   @default("01012345678") @db.VarChar(32)
  cardFeePercent      Decimal  @default(1.5) @db.Decimal(5, 2)
  printTemplateJson   Json?
  updatedAt           DateTime @updatedAt
}

model StaffUser {
  id                    String                @id @default(cuid())
  name                  String                @db.VarChar(120)
  role                  StaffRole
  pinHash               String                @db.VarChar(128)
  active                Boolean               @default(true)
  tokenVersion          Int                   @default(1)
  customPermissionsJson Json?
  lastLoginAt           DateTime?
  createdAt             DateTime              @default(now())
  invoices              Invoice[]
  priceChanges          ProductPriceHistory[]
  movements             StockMovement[]
  shiftClosed           ShiftClosure[]
}

model RolePermission {
  role            StaffRole @id
  permissionsJson Json
  updatedAt       DateTime  @updatedAt
}

model TreasuryAccount {
  id             String                     @id @default(cuid())
  name           String                     @db.VarChar(140)
  type           TreasuryType
  accountNumber  String                     @default("") @db.VarChar(120)
  currentBalance Decimal                    @default(0) @db.Decimal(14, 2)
  active         Boolean                    @default(true)
  isDefault      Boolean                    @default(false)
  notes          String                     @default("") @db.VarChar(255)
  updatedAt      DateTime                   @updatedAt
  transfersFrom  TreasuryTransfer[]         @relation("TransferFrom")
  transfersTo    TreasuryTransfer[]         @relation("TransferTo")
  allocations    InvoicePaymentAllocation[]
  expenses       StoreExpense[]
  purchases      PurchaseOrder[]
  drawings       EquityDrawing[]
}

model TreasuryTransfer {
  id             String          @id @default(cuid())
  fromTreasuryId String
  fromTreasury   TreasuryAccount @relation("TransferFrom", fields: [fromTreasuryId], references: [id])
  toTreasuryId   String
  toTreasury     TreasuryAccount @relation("TransferTo", fields: [toTreasuryId], references: [id])
  amount         Decimal         @db.Decimal(14, 2)
  notes          String          @default("") @db.VarChar(255)
  actorName      String          @db.VarChar(120)
  createdAt      DateTime        @default(now())

  @@index([createdAt])
}

model Product {
  id                 String                @id @default(cuid())
  activityId         String                @db.VarChar(64)
  sku                String                @unique @db.VarChar(64)
  barcode            String                @db.VarChar(64)
  name               String                @db.VarChar(180)
  category           String                @db.VarChar(120)
  unit               String                @db.VarChar(48)
  attributeValue     String                @default("") @db.VarChar(120)
  salePrice          Decimal               @db.Decimal(12, 2)
  halfWholesalePrice Decimal               @default(0) @db.Decimal(12, 2)
  wholesalePrice     Decimal               @default(0) @db.Decimal(12, 2)
  costPrice          Decimal               @db.Decimal(12, 2)
  stockQty           Decimal               @db.Decimal(12, 2)
  minStockAlert      Decimal               @db.Decimal(12, 2)
  maxStockTarget     Decimal               @db.Decimal(12, 2)
  supplierId         String?
  supplier           Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  updatedAt          DateTime              @updatedAt
  priceHistory       ProductPriceHistory[]
  movements          StockMovement[]
  invoiceItems       InvoiceItem[]
  batches            ProductBatch[]
  purchaseItems      PurchaseOrderItem[]

  @@index([activityId])
  @@index([barcode])
}

model ProductBatch {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String    @db.VarChar(180)
  batchCode   String    @db.VarChar(80)
  expiryDate  DateTime?
  qty         Decimal   @db.Decimal(12, 2)
  costPrice   Decimal   @db.Decimal(12, 2)
  supplierId  String?   @db.VarChar(64)
  purchaseId  String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())

  @@index([productId, expiryDate])
}

model ProductPriceHistory {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldSalePrice Decimal   @db.Decimal(12, 2)
  newSalePrice Decimal   @db.Decimal(12, 2)
  oldCostPrice Decimal   @db.Decimal(12, 2)
  newCostPrice Decimal   @db.Decimal(12, 2)
  changedById  String
  changedBy    StaffUser @relation(fields: [changedById], references: [id])
  reason       String    @default("") @db.VarChar(200)
  changedAt    DateTime  @default(now())

  @@index([productId, changedAt])
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       StockMovementType
  deltaQty   Decimal           @db.Decimal(12, 2)
  stockAfter Decimal           @db.Decimal(12, 2)
  refId      String            @default("") @db.VarChar(64)
  note       String            @default("") @db.VarChar(255)
  actorId    String
  actor      StaffUser         @relation(fields: [actorId], references: [id])
  createdAt  DateTime          @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id                     String               @id @default(cuid())
  name                   String               @db.VarChar(150)
  phone                  String               @db.VarChar(32)
  balanceDue             Decimal              @default(0) @db.Decimal(12, 2)
  totalPurchases         Decimal              @default(0) @db.Decimal(14, 2)
  creditLimit            Decimal              @default(0) @db.Decimal(12, 2)
  defaultPriceTier       PriceTier            @default(RETAIL)
  defaultDiscountPercent Decimal              @default(0) @db.Decimal(5, 2)
  loyaltyPoints          Int                  @default(0)
  storeCreditBalance     Decimal              @default(0) @db.Decimal(12, 2)
  notes                  String               @default("") @db.VarChar(255)
  lastPurchaseAt         DateTime?
  createdAt              DateTime             @default(now())
  invoices               Invoice[]
  transactions           PaymentTransaction[]
}

model Supplier {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(150)
  phone          String          @db.VarChar(32)
  company        String          @default("") @db.VarChar(150)
  category       String          @default("عام") @db.VarChar(120)
  balanceOwed    Decimal         @default(0) @db.Decimal(12, 2)
  notes          String          @default("") @db.VarChar(255)
  lastSupplyAt   DateTime?
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model StorePromotion {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(160)
  active      Boolean           @default(true)
  ruleType    PromotionRuleType
  value       Decimal           @db.Decimal(10, 2)
  minSubtotal Decimal           @default(0) @db.Decimal(12, 2)
  minQty      Decimal           @default(0) @db.Decimal(10, 2)
  category    String            @default("") @db.VarChar(120)
  productId   String?           @db.VarChar(64)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
}

model Invoice {
  id                    String                     @id @default(cuid())
  invoiceNumber         String                     @unique @db.VarChar(64)
  activityId            String                     @db.VarChar(64)
  customerId            String?
  customer              Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String                     @default("عميل نقدي") @db.VarChar(150)
  cashierId             String
  cashier               StaffUser                  @relation(fields: [cashierId], references: [id])
  cashierName           String                     @default("") @db.VarChar(120)
  paymentMethod         PaymentMethod
  status                InvoiceStatus              @default(COMPLETED)
  subtotal              Decimal                    @db.Decimal(12, 2)
  discountTotal         Decimal                    @default(0) @db.Decimal(12, 2)
  promotionDiscount     Decimal                    @default(0) @db.Decimal(12, 2)
  vatAmount             Decimal                    @default(0) @db.Decimal(12, 2)
  grandTotal            Decimal                    @db.Decimal(12, 2)
  totalCost             Decimal                    @db.Decimal(12, 2)
  netProfit             Decimal                    @db.Decimal(12, 2)
  paidAmount            Decimal                    @default(0) @db.Decimal(12, 2)
  changeAmount          Decimal                    @default(0) @db.Decimal(12, 2)
  returnedTotal         Decimal                    @default(0) @db.Decimal(12, 2)
  loyaltyPointsEarned   Int                        @default(0)
  loyaltyPointsRedeemed Int                        @default(0)
  storeCreditUsed       Decimal                    @default(0) @db.Decimal(12, 2)
  paymentRef            String                     @default("") @db.VarChar(120)
  dueDate               DateTime?
  exchangeForInvoiceId  String?                    @db.VarChar(64)
  notes                 String                     @default("") @db.VarChar(255)
  prevHash              String                     @db.VarChar(128)
  recordHash            String                     @db.VarChar(128)
  createdAt             DateTime                   @default(now())
  returnedAt            DateTime?
  items                 InvoiceItem[]
  allocations           InvoicePaymentAllocation[]
  returns               InvoiceReturn[]
  transactions          PaymentTransaction[]

  @@index([activityId, createdAt])
  @@index([status])
}

model InvoiceItem {
  id                String              @id @default(cuid())
  invoiceId         String
  invoice           Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product             @relation(fields: [productId], references: [id])
  productName       String              @db.VarChar(180)
  sku               String              @db.VarChar(64)
  unit              String              @default("قطعة") @db.VarChar(48)
  priceTier         PriceTier           @default(RETAIL)
  quantity          Decimal             @db.Decimal(12, 2)
  returnedQuantity  Decimal             @default(0) @db.Decimal(12, 2)
  unitPriceSnapshot Decimal             @db.Decimal(12, 2)
  unitCostSnapshot  Decimal             @db.Decimal(12, 2)
  discountAmount    Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal             @db.Decimal(12, 2)
  lineProfit        Decimal             @db.Decimal(12, 2)
  returnItems       InvoiceReturnItem[]

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePaymentAllocation {
  id            String           @id @default(cuid())
  invoiceId     String
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treasuryId    String?
  treasury      TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryName  String           @db.VarChar(140)
  method        PaymentMethod
  amount        Decimal          @db.Decimal(12, 2)
  feeAmount     Decimal          @default(0) @db.Decimal(12, 2)
  referenceCode String           @default("") @db.VarChar(120)

  @@index([invoiceId])
}

model InvoiceReturn {
  id                    String              @id @default(cuid())
  invoiceId             String
  invoice               Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actorName             String              @db.VarChar(120)
  reason                String              @default("") @db.VarChar(255)
  returnTotal           Decimal             @db.Decimal(12, 2)
  cashRefunded          Decimal             @default(0) @db.Decimal(12, 2)
  creditDebtReduced     Decimal             @default(0) @db.Decimal(12, 2)
  storeCreditAdded      Decimal             @default(0) @db.Decimal(12, 2)
  treasuryId            String?             @db.VarChar(64)
  treasuryName          String              @default("") @db.VarChar(140)
  exchangeInvoiceId     String?             @db.VarChar(64)
  exchangeInvoiceNumber String?             @db.VarChar(64)
  createdAt             DateTime            @default(now())
  items                 InvoiceReturnItem[]

  @@index([invoiceId, createdAt])
}

model InvoiceReturnItem {
  id            String        @id @default(cuid())
  returnId      String
  returnRecord  InvoiceReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   InvoiceItem   @relation(fields: [invoiceItemId], references: [id])
  productId     String        @db.VarChar(64)
  productName   String        @db.VarChar(180)
  quantity      Decimal       @db.Decimal(12, 2)
  refundAmount  Decimal       @db.Decimal(12, 2)
  costRecovered Decimal       @db.Decimal(12, 2)
}

model SalesQuotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique @db.VarChar(64)
  activityId         String          @db.VarChar(64)
  customerId         String?         @db.VarChar(64)
  customerName       String          @db.VarChar(150)
  customerPhone      String          @default("") @db.VarChar(32)
  status             QuotationStatus @default(ACTIVE)
  itemsJson          Json
  subtotal           Decimal         @db.Decimal(12, 2)
  discountTotal      Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal         @db.Decimal(12, 2)
  validUntil         DateTime
  notes              String          @default("") @db.VarChar(255)
  createdBy          String          @db.VarChar(120)
  convertedInvoiceId String?         @db.VarChar(64)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, createdAt])
}

model PurchaseOrder {
  id                 String                @id @default(cuid())
  purchaseNumber     String                @unique @db.VarChar(64)
  supplierId         String
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  supplierName       String                @db.VarChar(150)
  activityId         String                @db.VarChar(64)
  actorName          String                @db.VarChar(120)
  supplierInvoiceRef String                @default("") @db.VarChar(120)
  grandTotal         Decimal               @db.Decimal(12, 2)
  returnedTotal      Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal               @db.Decimal(12, 2)
  remainingDebt      Decimal               @db.Decimal(12, 2)
  paymentSource      PurchasePaymentSource
  treasuryId         String?
  treasury           TreasuryAccount?      @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryName       String                @default("") @db.VarChar(140)
  notes              String                @default("") @db.VarChar(255)
  createdAt          DateTime              @default(now())
  items              PurchaseOrderItem[]
  returns            PurchaseReturn[]

  @@index([supplierId, createdAt])
}

model PurchaseOrderItem {
  id               String               @id @default(cuid())
  purchaseId       String
  purchase         PurchaseOrder        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product              @relation(fields: [productId], references: [id])
  productName      String               @db.VarChar(180)
  unit             String               @db.VarChar(48)
  quantity         Decimal              @db.Decimal(12, 2)
  returnedQuantity Decimal              @default(0) @db.Decimal(12, 2)
  unitCost         Decimal              @db.Decimal(12, 2)
  newSalePrice     Decimal?             @db.Decimal(12, 2)
  batchCode        String               @default("") @db.VarChar(80)
  expiryDate       DateTime?
  lineTotal        Decimal              @db.Decimal(12, 2)
  returnItems      PurchaseReturnItem[]
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  purchaseId   String
  purchase     PurchaseOrder        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  actorName    String               @db.VarChar(120)
  reason       String               @default("") @db.VarChar(255)
  returnTotal  Decimal              @db.Decimal(12, 2)
  debtReduced  Decimal              @default(0) @db.Decimal(12, 2)
  cashRefunded Decimal              @default(0) @db.Decimal(12, 2)
  treasuryId   String?              @db.VarChar(64)
  treasuryName String               @default("") @db.VarChar(140)
  createdAt    DateTime             @default(now())
  items        PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id             String            @id @default(cuid())
  returnId       String
  returnRecord   PurchaseReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItemId String
  purchaseItem   PurchaseOrderItem @relation(fields: [purchaseItemId], references: [id])
  productId      String            @db.VarChar(64)
  productName    String            @db.VarChar(180)
  quantity       Decimal           @db.Decimal(12, 2)
  refundAmount   Decimal           @db.Decimal(12, 2)
}

model StoreExpense {
  id            String               @id @default(cuid())
  title         String               @db.VarChar(180)
  category      ExpenseCategory
  amount        Decimal              @db.Decimal(12, 2)
  paymentSource ExpensePaymentSource
  treasuryId    String?
  treasury      TreasuryAccount?     @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryName  String               @default("") @db.VarChar(140)
  receiptRef    String               @default("") @db.VarChar(120)
  actorName     String               @db.VarChar(120)
  notes         String               @default("") @db.VarChar(255)
  createdAt     DateTime             @default(now())

  @@index([createdAt, category])
}

model RecurringExpense {
  id            String               @id @default(cuid())
  title         String               @db.VarChar(180)
  category      ExpenseCategory
  amount        Decimal              @db.Decimal(12, 2)
  paymentSource ExpensePaymentSource
  treasuryId    String?              @db.VarChar(64)
  treasuryName  String               @default("") @db.VarChar(140)
  frequency     RecurringFrequency
  nextDueDate   DateTime
  lastPaidAt    DateTime?
  active        Boolean              @default(true)
  notes         String               @default("") @db.VarChar(255)
  createdAt     DateTime             @default(now())
}

model PaymentTransaction {
  id            String          @id @default(cuid())
  invoiceId     String?
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  treasuryId    String?         @db.VarChar(64)
  treasuryName  String          @default("") @db.VarChar(140)
  gateway       PaymentMethod
  referenceCode String          @db.VarChar(120)
  amount        Decimal         @db.Decimal(12, 2)
  feeAmount     Decimal         @default(0) @db.Decimal(12, 2)
  netAmount     Decimal         @default(0) @db.Decimal(12, 2)
  status        PaymentTxStatus @default(CONFIRMED)
  createdAt     DateTime        @default(now())

  @@index([createdAt])
}

model EquityPartner {
  id                  String          @id @default(cuid())
  name                String          @db.VarChar(150)
  phone               String          @default("") @db.VarChar(32)
  roleTitle           String          @default("شريك") @db.VarChar(100)
  capitalContribution Decimal         @default(0) @db.Decimal(14, 2)
  profitSharePercent  Decimal         @default(0) @db.Decimal(5, 2)
  active              Boolean         @default(true)
  notes               String          @default("") @db.VarChar(255)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  drawings            EquityDrawing[]
}

model EquityDrawing {
  id           String            @id @default(cuid())
  partnerId    String
  partner      EquityPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerName  String            @db.VarChar(150)
  amount       Decimal           @db.Decimal(14, 2)
  treasuryId   String?
  treasury     TreasuryAccount?  @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryName String            @default("") @db.VarChar(140)
  type         EquityDrawingType
  notes        String            @default("") @db.VarChar(255)
  actorName    String            @db.VarChar(120)
  createdAt    DateTime          @default(now())

  @@index([partnerId, createdAt])
}

model ScheduledReportConfig {
  id                  String                  @id @default(cuid())
  name                String                  @db.VarChar(160)
  active              Boolean                 @default(true)
  frequency           ScheduledFrequency
  dayOfWeek           Int                     @default(0)
  sendTime            String                  @default("22:00") @db.VarChar(8)
  channel             ScheduledChannel        @default(IN_APP)
  recipientEmailsJson Json
  activityFilter      String                  @default("all") @db.VarChar(64)
  includeProfits      Boolean                 @default(true)
  includeAlerts       Boolean                 @default(true)
  lastRunAt           DateTime?
  lastRunPeriodKey    String?                 @db.VarChar(32)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  digests             ScheduledReportDigest[]
}

model ScheduledReportDigest {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       ScheduledReportConfig @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleName   String                @db.VarChar(160)
  frequency      ScheduledFrequency
  periodKey      String                @db.VarChar(32)
  fromDate       DateTime
  toDate         DateTime
  title          String                @db.VarChar(200)
  summaryJson    Json
  channel        ScheduledChannel
  inAppDelivered Boolean               @default(true)
  isManualRun    Boolean               @default(false)
  createdAt      DateTime              @default(now())

  @@index([scheduleId, createdAt])
}

model ShiftClosure {
  id                  String    @id @default(cuid())
  cashierId           String
  cashier             StaffUser @relation(fields: [cashierId], references: [id])
  cashierName         String    @db.VarChar(120)
  periodStartAt       DateTime
  closedAt            DateTime  @default(now())
  openingFloat        Decimal   @db.Decimal(12, 2)
  cashSales           Decimal   @db.Decimal(12, 2)
  cashCollections     Decimal   @default(0) @db.Decimal(12, 2)
  cashReturns         Decimal   @default(0) @db.Decimal(12, 2)
  cashExpenses        Decimal   @default(0) @db.Decimal(12, 2)
  cashSupplierPayouts Decimal   @default(0) @db.Decimal(12, 2)
  cashEquityDrawings  Decimal   @default(0) @db.Decimal(12, 2)
  expectedCash        Decimal   @db.Decimal(12, 2)
  actualCash          Decimal   @db.Decimal(12, 2)
  variance            Decimal   @db.Decimal(12, 2)
  instapayTotal       Decimal   @db.Decimal(12, 2)
  walletTotal         Decimal   @db.Decimal(12, 2)
  cardTotal           Decimal   @db.Decimal(12, 2)
  creditTotal         Decimal   @db.Decimal(12, 2)
  invoiceCount        Int       @default(0)
  returnedCount       Int       @default(0)
  notes               String    @default("") @db.VarChar(255)
}

model SecurityAuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actorUserId String   @db.VarChar(64)
  actorName   String   @db.VarChar(120)
  action      String   @db.VarChar(255)
  category    String   @db.VarChar(32)
  target      String   @db.VarChar(120)
  details     String   @default("") @db.VarChar(500)

  @@index([timestamp])
}

model AppLicense {
  id                  Int      @id @default(1)
  storeId             String   @db.VarChar(64)
  plan                String   @default("PRO_COMMERCIAL") @db.VarChar(64)
  status              String   @default("ACTIVE") @db.VarChar(32)
  maxTerminals        Int      @default(10)
  hardwareFingerprint String   @db.VarChar(128)
  signatureHex        String   @db.VarChar(256)
  expiresAt           DateTime
  updatedAt           DateTime @updatedAt
}
