generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
}

enum StockMovementType {
  SALE
  RESTOCK
  RETURN
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
  CARD
  CREDIT
}

enum InvoiceStatus {
  COMPLETED
  RETURNED
}

enum PaymentTxStatus {
  CONFIRMED
  PENDING
  FAILED
}

model StoreSettings {
  id            Int      @id @default(1)
  storeName     String   @db.VarChar(180)
  activityId    String   @default("grocery") @db.VarChar(64)
  phone         String   @db.VarChar(32)
  address       String   @db.VarChar(255)
  taxNumber     String   @default("") @db.VarChar(64)
  receiptFooter String   @db.VarChar(320)
  currency      String   @default("EGP") @db.VarChar(8)
  updatedAt     DateTime @updatedAt
}

model StaffUser {
  id           String                @id @default(cuid())
  name         String                @db.VarChar(120)
  role         StaffRole
  pinHash      String                @db.VarChar(128)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  invoices     Invoice[]
  priceChanges ProductPriceHistory[]
  movements    StockMovement[]
  shiftClosed  ShiftClosure[]
}

model RolePermission {
  role            StaffRole @id
  permissionsJson Json
  updatedAt       DateTime  @updatedAt
}

model Product {
  id             String                @id @default(cuid())
  activityId     String                @db.VarChar(64)
  sku            String                @unique @db.VarChar(64)
  barcode        String                @db.VarChar(64)
  name           String                @db.VarChar(180)
  category       String                @db.VarChar(120)
  unit           String                @db.VarChar(48)
  salePrice      Decimal               @db.Decimal(12, 2)
  costPrice      Decimal               @db.Decimal(12, 2)
  stockQty       Decimal               @db.Decimal(12, 2)
  minStockAlert  Decimal               @db.Decimal(12, 2)
  maxStockTarget Decimal               @db.Decimal(12, 2)
  updatedAt      DateTime              @updatedAt
  priceHistory   ProductPriceHistory[]
  movements      StockMovement[]
  invoiceItems   InvoiceItem[]

  @@index([activityId])
  @@index([barcode])
}

model ProductPriceHistory {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldSalePrice Decimal   @db.Decimal(12, 2)
  newSalePrice Decimal   @db.Decimal(12, 2)
  oldCostPrice Decimal   @db.Decimal(12, 2)
  newCostPrice Decimal   @db.Decimal(12, 2)
  changedById  String
  changedBy    StaffUser @relation(fields: [changedById], references: [id])
  changedAt    DateTime  @default(now())

  @@index([productId, changedAt])
}

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       StockMovementType
  deltaQty   Decimal           @db.Decimal(12, 2)
  stockAfter Decimal           @db.Decimal(12, 2)
  refId      String            @default("") @db.VarChar(64)
  note       String            @default("") @db.VarChar(255)
  actorId    String
  actor      StaffUser         @relation(fields: [actorId], references: [id])
  createdAt  DateTime          @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id            String               @id @default(cuid())
  name          String               @db.VarChar(150)
  phone         String               @db.VarChar(32)
  balanceDue    Decimal              @default(0) @db.Decimal(12, 2)
  loyaltyPoints Int                  @default(0)
  createdAt     DateTime             @default(now())
  invoices      Invoice[]
  transactions  PaymentTransaction[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(150)
  phone       String   @db.VarChar(32)
  company     String   @db.VarChar(150)
  balanceOwed Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Invoice {
  id            String               @id @default(cuid())
  invoiceNumber String               @unique @db.VarChar(64)
  activityId    String               @db.VarChar(64)
  customerId    String?
  customer      Customer?            @relation(fields: [customerId], references: [id])
  customerName  String               @default("عميل نقدي") @db.VarChar(150)
  cashierId     String
  cashier       StaffUser            @relation(fields: [cashierId], references: [id])
  paymentMethod PaymentMethod
  status        InvoiceStatus        @default(COMPLETED)
  subtotal      Decimal              @db.Decimal(12, 2)
  discountTotal Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal              @db.Decimal(12, 2)
  totalCost     Decimal              @db.Decimal(12, 2)
  netProfit     Decimal              @db.Decimal(12, 2)
  paymentRef    String               @default("") @db.VarChar(120)
  prevHash      String               @db.VarChar(128)
  recordHash    String               @db.VarChar(128)
  createdAt     DateTime             @default(now())
  returnedAt    DateTime?
  items         InvoiceItem[]
  transactions  PaymentTransaction[]

  @@index([activityId, createdAt])
  @@index([status])
}

model InvoiceItem {
  id                String  @id @default(cuid())
  invoiceId         String
  invoice           Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  productName       String  @db.VarChar(180)
  sku               String  @db.VarChar(64)
  quantity          Decimal @db.Decimal(12, 2)
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  unitCostSnapshot  Decimal @db.Decimal(12, 2)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(12, 2)
  lineProfit        Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
}

model PaymentTransaction {
  id            String          @id @default(cuid())
  invoiceId     String?
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id])
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  gateway       PaymentMethod
  referenceCode String          @db.VarChar(120)
  amount        Decimal         @db.Decimal(12, 2)
  status        PaymentTxStatus @default(CONFIRMED)
  createdAt     DateTime        @default(now())

  @@index([createdAt])
}

model ShiftClosure {
  id            String    @id @default(cuid())
  cashierId     String
  cashier       StaffUser @relation(fields: [cashierId], references: [id])
  cashierName   String    @db.VarChar(120)
  periodStartAt DateTime
  closedAt      DateTime  @default(now())
  openingFloat  Decimal   @db.Decimal(12, 2)
  expectedCash  Decimal   @db.Decimal(12, 2)
  actualCash    Decimal   @db.Decimal(12, 2)
  variance      Decimal   @db.Decimal(12, 2)
  cashSales     Decimal   @db.Decimal(12, 2)
  instapayTotal Decimal   @db.Decimal(12, 2)
  walletTotal   Decimal   @db.Decimal(12, 2)
  cardTotal     Decimal   @db.Decimal(12, 2)
  creditTotal   Decimal   @db.Decimal(12, 2)
  notes         String    @default("") @db.VarChar(255)
}

model AppLicense {
  id                  Int      @id @default(1)
  storeId             String   @db.VarChar(64)
  plan                String   @default("PRO_COMMERCIAL") @db.VarChar(64)
  status              String   @default("ACTIVE") @db.VarChar(32)
  hardwareFingerprint String   @db.VarChar(128)
  signatureHex        String   @db.VarChar(256)
  expiresAt           DateTime
  updatedAt           DateTime @updatedAt
}
