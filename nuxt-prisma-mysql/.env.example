# MySQL 8.0 Connection String for Prisma (Local, Docker, or Managed MySQL on Cloud/VPS)
DATABASE_URL="mysql://tajirpro_user:tajirpro_pass@127.0.0.1:3306/tajirpro_pos"

# Secret keys for HMAC-SHA256 session authentication, license signing & invoice chain
NUXT_SESSION_SECRET="CHANGE_THIS_SESSION_SECRET_32_CHARS_MIN"
NUXT_LICENSE_SECRET="CHANGE_THIS_LICENSE_SECRET_32_CHARS_MIN"

# Optional secret to protect scheduled report cron endpoint (/api/cron/scheduled-reports)
CRON_SECRET=""

# Public URL when deployed on Vercel
NUXT_PUBLIC_APP_URL="https://tajirpro.vercel.app"

