{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.ts": {
      "includeFiles": "{src/server/**,src/shared/**,node_modules/better-sqlite3/prebuilds/linux*.node,node_modules/better-sqlite3/build/**}",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/handler"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler?__vpath=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
